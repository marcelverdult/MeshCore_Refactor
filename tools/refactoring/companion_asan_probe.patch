diff --git a/test/test_companion_frames/test_asan_probe.cpp b/test/test_companion_frames/test_asan_probe.cpp
new file mode 100644
index 00000000..d315f549
--- /dev/null
+++ b/test/test_companion_frames/test_asan_probe.cpp
@@ -0,0 +1,24 @@
+// ASan probe for reads past len: every code, every length, ten fills. Bytes above
+// the frame are poisoned from len + PROBE_SKIP (0: the byte at len too).
+#include "CompanionHarness.h"
+#include <cstdlib>
+using namespace companion;
+TEST(AsanProbe, AllCodesAllLengths) {
+  const char* e = getenv("PROBE_SKIP");
+  if (!e) GTEST_SKIP();
+  g_poison_skip = atoi(e);
+  const uint8_t fills[] = {0x00, 0x01, 0x02, 0x3F, 0x40, 0x7F, 0x81, 0xBF, 0xFF, 0x5A};
+  Harness h;
+  for (int code = 0; code < 70; code++) {
+    for (uint8_t fill : fills) {
+      for (size_t len = 1; len <= MAX_FRAME_SIZE; len++) {
+        h.reset();
+        h.boot();
+        Bytes f; putU8(f, (uint8_t)code); putFill(f, len - 1, fill);
+        fprintf(stderr, "PROBE code=%d fill=%02x len=%zu\n", code, fill, len);
+        h.send(f);
+      }
+    }
+  }
+  g_poison_skip = 1;
+}
